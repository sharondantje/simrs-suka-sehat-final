{
  "regions": ["sin1"],
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "maxDuration": 60
    }
  },
  "routes": [
    { "src": "/(config|includes|database|api)(/.*)?", "dest": "/api/index.php" },
    { "src": "/(.*)\\.php", "dest": "/api/index.php" },
    { "src": "/(.*/)?", "dest": "/api/index.php" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
